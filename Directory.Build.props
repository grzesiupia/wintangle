<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- GitVersion drives Version/FileVersion/AssemblyVersion/InformationalVersion
         from git history + tags for every project (single source of truth). -->
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
