<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wintangle.ico</ApplicationIcon>
    <StartupObject>Wintangle.App.Program</StartupObject>
    <Product>wintangle</Product>
    <Company>wintangle contributors</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wintangle.Core\Wintangle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon as an embedded resource (settings window header). Uses
         EmbeddedResource rather than Resource: the WPF pipeline silently
         drops a <Resource> item that duplicates ApplicationIcon. -->
    <EmbeddedResource Include="Assets\wintangle.ico" LogicalName="wintangle.ico" />
  </ItemGroup>

</Project>
