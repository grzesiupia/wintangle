<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- wintangle dark theme — brushes only. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#242424" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#333333" />
    <SolidColorBrush x:Key="Brush.Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#A6A6A6" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Brush.SelectionBorder" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF7B72" />
    <SolidColorBrush x:Key="Brush.ShortcutChipBg" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Brush.ShortcutChipFg" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Brush.TabInactiveFg" Color="#A6A6A6" />
    <SolidColorBrush x:Key="Brush.RecordingFg" Color="#2B6CB0" />

</ResourceDictionary>
