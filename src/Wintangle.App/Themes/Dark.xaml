<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- wintangle dark theme — brushes + fonts (design tokens from the
         wintangle-app.html export). -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#090E12" />
    <SolidColorBrush x:Key="Brush.Bg2" Color="#0D1217" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#13191F" />
    <SolidColorBrush x:Key="Brush.Fg" Color="#E9EBEE" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#9399A0" />
    <SolidColorBrush x:Key="Brush.Border" Color="#282F36" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#6BADFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2E6BADFF" />
    <SolidColorBrush x:Key="Brush.FgSoft" Color="#12E9EBEE" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F97770" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#29F97770" />
    <SolidColorBrush x:Key="Brush.CloseHoverText" Color="#FFF6F7" />
    <SolidColorBrush x:Key="Brush.ThemeDotDark" Color="#12171B" />
    <SolidColorBrush x:Key="Brush.ThemeDotLight" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Brush.DeskTaskbar" Color="#0B1014" />
    <SolidColorBrush x:Key="Brush.GoHover" Color="#CC605B" />
    <SolidColorBrush x:Key="Brush.AccentBorder45" Color="#736BADFF" />
    <SolidColorBrush x:Key="Brush.Muted60" Color="#60666C" />
    <SolidColorBrush x:Key="Brush.DangerBorder32" Color="#52F97770" />
    <SolidColorBrush x:Key="Brush.FgHoverBorder" Color="#464B51" />

    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
