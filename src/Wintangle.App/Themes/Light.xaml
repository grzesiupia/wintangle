<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- wintangle light theme — brushes only (same keys as Dark.xaml). -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#3F3F3F" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#6E6E6E" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.SelectionBorder" Color="#40000000" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#0A000000" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="Brush.ShortcutChipBg" Color="#E8E8E8" />
    <SolidColorBrush x:Key="Brush.ShortcutChipFg" Color="#3F3F3F" />
    <SolidColorBrush x:Key="Brush.TabInactiveFg" Color="#6E6E6E" />
    <SolidColorBrush x:Key="Brush.RecordingFg" Color="#2563EB" />

</ResourceDictionary>
