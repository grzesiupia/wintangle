<Window x:Class="Wintangle.App.UI.Tray.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="wintangle notification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="16" Cursor="Hand" MouseLeftButtonDown="OnToastClick">
        <!-- Toast container (320px width, 11px radius, design shadow) -->
        <Border Width="320"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="11"
                Padding="16,13">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="8"
                                  Opacity="0.38"
                                  Color="{DynamicResource Color.Shadow}" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="12" />
            </Border.RenderTransform>

            <StackPanel>
                <!-- Title row with colored status indicator dot -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusDot"
                            Width="8"
                            Height="8"
                            CornerRadius="4"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Accent}" />
                    <TextBlock x:Name="TitleText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Fg}"
                               Text="wintangle" />
                </StackPanel>

                <!-- Message text -->
                <TextBlock x:Name="MessageText"
                           FontSize="12.5"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Muted}"
                           Text="Notification message" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
