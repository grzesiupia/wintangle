<UserControl x:Class="Wintangle.App.UI.Tabs.LayoutsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Wintangle.App.UI.Controls">
    <StackPanel>
        <TextBlock Style="{DynamicResource PaneHeader}" Text="Window layouts" />
        <TextBlock Style="{DynamicResource PaneSub}"
                   Margin="0,4,0,26"
                   Text="Sixteen fixed slots. Click a slot to apply it to the focused window — or press its chord. Gaps respect the work area and your window's min / max sizes." />

        <!-- 16 slot cards (center-half first), 4 columns, 10px gap -->
        <UniformGrid x:Name="SlotGrid" Columns="4" />

        <!-- Preview row: live desktop mock + active windows -->
        <Grid Margin="0,34,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{DynamicResource PanelLabel}" Text="LIVE PREVIEW" />
                <controls:DesktopPreview x:Name="Desktop" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource PanelLabel}"
                               Text="ACTIVE WINDOWS"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Style="{DynamicResource GhostButton}"
                            Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="RefreshIcon"
                                  Width="13"
                                  Height="13"
                                  Margin="0,0,7,0"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M20 11a8 8 0 0 0-15-3m-1 7a8 8 0 0 0 15 3M20 4v4h-4M4 20v-4h4" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl x:Name="WindowsList" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
