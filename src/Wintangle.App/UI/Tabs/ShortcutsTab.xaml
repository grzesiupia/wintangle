<UserControl x:Class="Wintangle.App.UI.Tabs.ShortcutsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{DynamicResource PaneHeader}" Text="Keyboard shortcuts" />
        <TextBlock Style="{DynamicResource PaneSub}" Margin="0,4,0,14">
            <Run Text="Eighteen actions, every one rebindable. Press " />
            <Run Text="Record"
                 FontFamily="{DynamicResource Font.Mono}"
                 FontSize="12" />
            <Run Text=", then press a chord — it commits immediately. Esc cancels. Conflicts and modifier-less combos are rejected." />
        </TextBlock>
        <StackPanel x:Name="ShortcutsHost" />
    </StackPanel>
</UserControl>
