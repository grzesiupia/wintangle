<UserControl x:Class="Wintangle.App.UI.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Wintangle.App.UI.Controls">
    <StackPanel>
        <TextBlock Style="{DynamicResource PaneHeader}" Text="Settings" />
        <TextBlock Style="{DynamicResource PaneSub}" Margin="0,4,0,18">
            <Run Text="Everything persists to " />
            <Run Text="config.json"
                 FontFamily="{DynamicResource Font.Mono}"
                 FontSize="12" />
            <Run Text=" and applies the instant you change it. Externally edited config is reloaded live." />
        </TextBlock>

        <!-- ── Spacing ─────────────────────────────────────────────────── -->
        <Border Style="{DynamicResource SGroup}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource SGroupHead}" Text="Spacing" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource SGroupNote}" Text="0–50 px" />
                </Grid>

                <!-- gap-row: two gap items, 28px gutter -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Window gap -->
                    <StackPanel Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Window gap"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Fg}" />
                            <TextBlock x:Name="WindowGapValue"
                                       Grid.Column="1"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="WindowGapSlider"
                                    Style="{DynamicResource GapSlider}"
                                    VerticalAlignment="Center"
                                    ValueChanged="WindowGapSlider_ValueChanged" />
                            <TextBox x:Name="WindowGapBox"
                                     Grid.Column="1"
                                     Width="58"
                                     Margin="12,0,0,0"
                                     MaxLength="2"
                                     TextAlignment="Center"
                                     Style="{DynamicResource AppTextBox}"
                                     ToolTip="Integer 0–50. Applies on Enter or when the box loses focus."
                                     KeyDown="GapBox_KeyDown"
                                     LostKeyboardFocus="WindowGapBox_LostFocus" />
                        </Grid>
                        <TextBlock Style="{DynamicResource GapHint}"
                                   Text="Space between adjacent windows. Committed on Enter or blur." />
                    </StackPanel>

                    <!-- Edge gap -->
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Edge gap"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Fg}" />
                            <TextBlock x:Name="EdgeGapValue"
                                       Grid.Column="1"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="EdgeGapSlider"
                                    Style="{DynamicResource GapSlider}"
                                    VerticalAlignment="Center"
                                    ValueChanged="EdgeGapSlider_ValueChanged" />
                            <TextBox x:Name="EdgeGapBox"
                                     Grid.Column="1"
                                     Width="58"
                                     Margin="12,0,0,0"
                                     MaxLength="2"
                                     TextAlignment="Center"
                                     Style="{DynamicResource AppTextBox}"
                                     ToolTip="Integer 0–50. Applies on Enter or when the box loses focus."
                                     KeyDown="GapBox_KeyDown"
                                     LostKeyboardFocus="EdgeGapBox_LostFocus" />
                        </Grid>
                        <TextBlock Style="{DynamicResource GapHint}"
                                   Text="Space between windows and screen edges." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Appearance ───────────────────────────────────────────────── -->
        <Border Style="{DynamicResource SGroup}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource SGroupHead}" Text="Appearance" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource SGroupNote}" Text="applies instantly" />
                </Grid>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ThemeCard x:Name="SystemThemeCard"
                                        Theme="System"
                                        Note="Follow Windows"
                                        Margin="0,0,6,0"
                                        Style="{DynamicResource ThemeCard}"
                                        Click="ThemeCard_Click" />
                    <controls:ThemeCard x:Name="DarkThemeCard"
                                        Theme="Dark"
                                        Note="Default"
                                        Grid.Column="1"
                                        Margin="3,0,3,0"
                                        Style="{DynamicResource ThemeCard}"
                                        Click="ThemeCard_Click" />
                    <controls:ThemeCard x:Name="LightThemeCard"
                                        Theme="Light"
                                        Note="Window title follows"
                                        Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Style="{DynamicResource ThemeCard}"
                                        Click="ThemeCard_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Startup ──────────────────────────────────────────────────── -->
        <Border Style="{DynamicResource SGroup}">
            <StackPanel>
                <TextBlock Style="{DynamicResource SGroupHead}" Text="Startup" />
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Start Wintangle when I log in"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Fg}" />
                        <TextBlock Text="A per-user registry entry — no administrator rights required."
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Muted}"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <controls:Switch x:Name="AutoStartSwitch"
                                     Grid.Column="1"
                                     Margin="16,0,0,0"
                                     VerticalAlignment="Center"
                                     Style="{DynamicResource Switch}"
                                     AutomationProperties.Name="Autostart"
                                     Checked="AutoStartSwitch_Checked"
                                     Unchecked="AutoStartSwitch_Unchecked" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Ignored apps ─────────────────────────────────────────────── -->
        <Border Style="{DynamicResource SGroup}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource SGroupHead}" Text="Ignored apps" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource SGroupNote}" Text="never tiled or moved" />
                </Grid>
                <TextBlock Style="{DynamicResource PaneSub}"
                           Text="Windows from ignored apps are skipped entirely. Manage from here or from the tray menu." />
                <Grid Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IgnoreAddBox"
                             Height="38"
                             VerticalContentAlignment="Center"
                             Style="{DynamicResource AppTextBox}"
                             Tag="process name, e.g. steam.exe"
                             ToolTip="Process name, e.g. steam.exe"
                             KeyDown="IgnoreAddBox_KeyDown" />
                    <Button Grid.Column="1"
                            Style="{DynamicResource GhostButton}"
                            Content="Add"
                            FontWeight="SemiBold"
                            Margin="8,0,0,0"
                            Click="IgnoreAddButton_Click" />
                </Grid>
                <StackPanel x:Name="IgnoredList" />
                <TextBlock Style="{DynamicResource SGroupNote}"
                           Text="RUNNING APPS (CLICK TO IGNORE)"
                           Margin="0,16,0,8" />
                <WrapPanel x:Name="RunningAppsPanel" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ── Updates ──────────────────────────────────────────────────── -->
        <Border Style="{DynamicResource SGroup}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource SGroupHead}" Text="Updates" />
                    <TextBlock x:Name="CurrentVersionText"
                               Grid.Column="1"
                               Style="{DynamicResource SGroupNote}"
                               Text="v1.0.5" />
                </Grid>
                <TextBlock x:Name="UpdateStatusText"
                           Style="{DynamicResource PaneSub}"
                           Margin="0,6,0,0"
                           Text="Check GitHub for the latest wintangle releases and improvements." />

                <ProgressBar x:Name="UpdateProgressBar"
                             Style="{DynamicResource AppProgressBar}"
                             Margin="0,12,0,0"
                             Visibility="Collapsed"
                             Minimum="0"
                             Maximum="100" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CheckUpdatesButton"
                            Style="{DynamicResource GhostButton}"
                            Content="Check for updates"
                            Click="CheckUpdatesButton_Click" />
                    <Button x:Name="InstallUpdateButton"
                            Style="{DynamicResource AccentButton}"
                            Content="Download and Install"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="InstallUpdateButton_Click" />
                    <Button x:Name="ReleaseNotesButton"
                            Style="{DynamicResource GhostButton}"
                            Content="View release notes"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="ReleaseNotesButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Restore defaults ─────────────────────────────────────────── -->
        <Border Style="{DynamicResource SGroup}"
                BorderBrush="{DynamicResource Brush.DangerBorder32}">
            <StackPanel>
                <TextBlock Style="{DynamicResource SGroupHead}" Text="Restore defaults" />
                <TextBlock Style="{DynamicResource PaneSub}"
                           Text="Reset gaps (8 / 0), all 19 shortcuts, autostart and the ignored-app list. Requires confirmation." />
                <Button x:Name="RestoreDefaultsButton"
                        Style="{DynamicResource DangerOutlineButton}"
                        Content="Restore defaults…"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0"
                        Click="RestoreDefaultsButton_Click" />

                <!-- Inline confirmation bar (revealed on demand). -->
                <Border x:Name="RestoreConfirmBar"
                        Visibility="Collapsed"
                        Margin="0,14,0,0"
                        Padding="12,16"
                        CornerRadius="10"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.DangerSoft}"
                        BorderBrush="{DynamicResource Brush.Danger}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Reset everything to factory defaults?"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Fg}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{DynamicResource GhostButton}"
                                Content="Cancel"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Click="RestoreCancel_Click" />
                        <Button Grid.Column="2"
                                Style="{DynamicResource DangerButton}"
                                Content="Restore defaults"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Click="RestoreGo_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
