<UserControl x:Class="Wintangle.App.UI.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,14">
            <!-- MaxGap matches GapSettings.MaxGap (Core). Applied on Enter/LostFocus. -->
            <TextBlock Text="Window gap (px between tiled windows)" FontWeight="SemiBold" />
            <TextBox x:Name="WindowGapBox"
                     Width="60"
                     Margin="0,4,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     MaxLength="2"
                     ToolTip="Integer 0–50. Applies on Enter or when the box loses focus."
                     KeyDown="GapBox_KeyDown"
                     LostKeyboardFocus="WindowGapBox_LostFocus" />

            <TextBlock Text="Edge gap (px from screen edges)" FontWeight="SemiBold" Margin="0,18,0,0" />
            <TextBox x:Name="EdgeGapBox"
                     Width="60"
                     Margin="0,4,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     MaxLength="2"
                     ToolTip="Integer 0–50. Applies on Enter or when the box loses focus."
                     KeyDown="GapBox_KeyDown"
                     LostKeyboardFocus="EdgeGapBox_LostFocus" />

            <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,18,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <RadioButton x:Name="DarkThemeRadio"
                             Content="Dark"
                             GroupName="ThemeGroup"
                             Checked="ThemeRadio_Checked" />
                <RadioButton x:Name="LightThemeRadio"
                             Content="Light"
                             GroupName="ThemeGroup"
                             Margin="20,0,0,0"
                             Checked="ThemeRadio_Checked" />
            </StackPanel>

            <CheckBox x:Name="AutostartCheckBox"
                      Content="Start wintangle when I log in"
                      Margin="0,18,0,0"
                      Checked="AutostartCheckBox_Checked"
                      Unchecked="AutostartCheckBox_Unchecked" />

            <TextBlock Text="Ignored apps" FontWeight="SemiBold" Margin="0,18,0,0" />
            <TextBlock Text="Windows of ignored apps are never moved by wintangle."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,2,0,0" />
            <ListBox x:Name="IgnoredList" Height="140" Margin="0,8,0,8" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="IgnoreAddBox"
                         Width="220"
                         ToolTip="Process name, e.g. notepad"
                         KeyDown="IgnoreAddBox_KeyDown" />
                <Button Content="Add"
                        Margin="6,0,0,0"
                        Padding="14,2"
                        Click="IgnoreAddButton_Click" />
                <Button Content="Remove"
                        Margin="6,0,0,0"
                        Padding="14,2"
                        Click="IgnoreRemoveButton_Click" />
            </StackPanel>
            <TextBlock Text="Add apps via tray: right-click icon → Ignore this app"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       Margin="0,8,0,0" />

            <Button x:Name="RestoreDefaultsButton"
                    Content="Restore defaults…"
                    Margin="0,22,0,0"
                    Padding="14,4"
                    HorizontalAlignment="Left"
                    Click="RestoreDefaultsButton_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
