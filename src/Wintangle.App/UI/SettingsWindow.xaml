<Window x:Class="Wintangle.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="wintangle"
        Width="920" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Bg}">
    <Window.Resources>
        <!-- Tab-bar radio: inactive TabInactiveFg, active TextPrimary + underline. -->
        <Style x:Key="SettingsTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TabInactiveFg}" />
            <Setter Property="Margin" Value="0,0,28,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                            <Border x:Name="Underline"
                                    Height="2"
                                    Margin="0,6,0,0"
                                    CornerRadius="1"
                                    Background="{DynamicResource Brush.Accent}"
                                    Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: icon + name, version right-aligned -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="HeaderIcon" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="wintangle"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
            <TextBlock Grid.Column="3"
                       Text="1.0.0"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Tab bar: scrolls horizontally instead of clipping at MinWidth with font scaling -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LayoutsTabRadio"
                             Style="{StaticResource SettingsTabRadio}"
                             GroupName="SettingsTabs"
                             IsChecked="True"
                             Checked="OnTabChecked">
                    <TextBlock Text="Window Layouts" />
                </RadioButton>
                <RadioButton x:Name="AdvancedRulesTabRadio"
                             Style="{StaticResource SettingsTabRadio}"
                             GroupName="SettingsTabs"
                             Checked="OnTabChecked">
                    <TextBlock Text="Advanced Rules" />
                </RadioButton>
                <RadioButton x:Name="ShortcutsTabRadio"
                             Style="{StaticResource SettingsTabRadio}"
                             GroupName="SettingsTabs"
                             Checked="OnTabChecked">
                    <TextBlock Text="Keyboard Shortcuts" />
                </RadioButton>
                <RadioButton x:Name="MouseActionsTabRadio"
                             Style="{StaticResource SettingsTabRadio}"
                             GroupName="SettingsTabs"
                             Checked="OnTabChecked">
                    <TextBlock Text="Mouse Actions" />
                </RadioButton>
                <RadioButton x:Name="PluginsTabRadio"
                             Style="{StaticResource SettingsTabRadio}"
                             GroupName="SettingsTabs"
                             Checked="OnTabChecked">
                    <TextBlock Text="Plugins" />
                </RadioButton>
                <RadioButton x:Name="WorkspacesTabRadio"
                             Style="{StaticResource SettingsTabRadio}"
                             GroupName="SettingsTabs"
                             Checked="OnTabChecked">
                    <TextBlock Text="Workspaces" />
                </RadioButton>
                <RadioButton x:Name="SettingsTabRadio"
                             Style="{StaticResource SettingsTabRadio}"
                             GroupName="SettingsTabs"
                             Checked="OnTabChecked">
                    <TextBlock Text="Settings" />
                </RadioButton>
            </StackPanel>
        </ScrollViewer>

        <!-- Content: tab panels (visibility swapped in code-behind) -->
        <Grid x:Name="ContentHost" Grid.Row="2" Margin="0,16,0,0" />
    </Grid>
</Window>
