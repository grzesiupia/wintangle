<Window x:Class="Wintangle.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wintangle.App.UI.Controls"
        Title="Settings · Wintangle"
        Width="960" Height="680"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Brush.Surface}"
        ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Titlebar ─────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Bg2}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <!-- Subtle top sheen overlay -->
                <Border Background="{DynamicResource Brush.HeaderSheen}"
                        IsHitTestVisible="False" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="HeaderIcon"
                           Width="16" Height="16"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Fg}">
                        Settings<Run Text="· Wintangle"
                                     FontWeight="Normal"
                                     Foreground="{DynamicResource Brush.Muted}" />
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <controls:WindowButton x:Name="MinimizeButton"
                                               Style="{DynamicResource TitlebarButton}"
                                               Glyph="M1.5 6h9"
                                               ToolTip="Minimize"
                                               AutomationProperties.Name="Minimize"
                                               Click="MinimizeButton_Click" />
                        <controls:WindowButton x:Name="MaximizeButton"
                                               Style="{DynamicResource TitlebarButton}"
                                               Glyph="M1.5 1.5h9v9h-9z"
                                               ToolTip="Maximize"
                                               AutomationProperties.Name="Maximize"
                                               Click="MaximizeButton_Click" />
                        <controls:WindowButton x:Name="CloseButton"
                                               Style="{DynamicResource TitlebarButton}"
                                               Glyph="M2 2l8 8M10 2l-8 8"
                                               IsClose="True"
                                               ToolTip="Close"
                                               AutomationProperties.Name="Close"
                                               Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Body: rail + pane host ───────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tab rail -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,1,0"
                    Padding="20,12">
                <StackPanel>
                    <controls:TabButton x:Name="ShortcutsTabButton"
                                        Style="{DynamicResource TabButton}"
                                        Icon="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M6 8h.01 M9 8h.01 M12 8h.01 M6 12h.01 M9 12h4 M6 16h.01 M15 16h3"
                                        Content="Keyboard shortcuts"
                                        GroupName="SettingsTabs"
                                        IsSelected="True"
                                        Margin="0,0,0,4"
                                        Click="ShortcutsTabButton_Click" />
                    <controls:TabButton x:Name="SettingsTabButton"
                                        Style="{DynamicResource TabButton}"
                                        Icon="M4 7h16 M4 12h16 M4 17h16 M7 7a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M13 12a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M5 17a2 2 0 1 0 4 0a2 2 0 1 0-4 0"
                                        Content="Settings"
                                        GroupName="SettingsTabs"
                                        Click="SettingsTabButton_Click" />
                </StackPanel>
            </Border>

            <!-- Pane host: two panels, visibility-swapped by ShowTab -->
            <Grid Grid.Column="1">
                <ScrollViewer x:Name="ShortcutsScroll"
                              VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="ShortcutsHost"
                                    Margin="36,24,44,44"
                                    Focusable="False" />
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsScroll"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <ContentControl x:Name="SettingsHost"
                                    Margin="36,24,44,44"
                                    Focusable="False" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
