<UserControl x:Class="Wintangle.App.UI.Controls.PlaceholderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="360"
                Margin="24">
        <TextBlock x:Name="IconGlyph"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="28"
                   Foreground="{DynamicResource Brush.TextTertiary}"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="TitleText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
        <TextBlock x:Name="DescriptionText"
                   FontSize="13"
                   Foreground="{DynamicResource Brush.TextTertiary}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
        <Button x:Name="ActionButton"
                Content=""
                IsEnabled="False"
                Background="{DynamicResource Brush.SurfaceAlt}"
                Foreground="{DynamicResource Brush.TextSecondary}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                Padding="16,6"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Visibility="Collapsed" />
    </StackPanel>
</UserControl>
