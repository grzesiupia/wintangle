<UserControl x:Class="Wintangle.App.UI.Controls.RebindRecorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- bind-box: keycap chips container; blink/recording/danger states
                 are driven in code (Opacity animation, BorderBrush swap). -->
            <Border x:Name="BindBox"
                    MinWidth="150"
                    MinHeight="26"
                    Padding="6,4"
                    BorderThickness="1"
                    CornerRadius="7"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Brush.Border}">
                <StackPanel x:Name="ChipsHost" Orientation="Horizontal" />
            </Border>
            <Button x:Name="RecordButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="Record"
                    Style="{DynamicResource RecordButton}"
                    Click="RecordButton_Click" />
            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="Cancel"
                    Style="{DynamicResource CancelButton}"
                    Visibility="Collapsed"
                    Click="CancelButton_Click" />
        </Grid>
        <TextBlock x:Name="ErrorText"
                   Grid.Row="1"
                   Margin="0,6,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Danger}"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
